{
  "extends": ["markuplint:recommended-react"],
  "parser": {
    "\\.[jt]sx$": "@markuplint/jsx-parser"
  },
  "specs": {
    "\\.[jt]sx$": "@markuplint/react-spec"
  },
  "rules": {
    "require-h1": false,
    "no-event-handler-attr": false
  },
  "nodeRules": [
    {
      "selector": "button",
      "rules": { "require-attr": "type" }
    }
  ]
}
